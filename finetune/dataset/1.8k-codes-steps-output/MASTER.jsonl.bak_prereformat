{"messages": [{"role": "user", "content": "Write `resolveCollisions(entities)` \u2014 detect and respond to pairwise collisions (circle vs circle). Return updated list."}, {"role": "assistant", "content": "```falcon\nfunc resolveCollisions(entities) =\n  {\n    local updated = copyList(entities)\n    for (i: 1 .. updated.listLen() step 1) {\n      for (j: i + 1 .. updated.listLen() step 1) {\n        local a = updated[i]\n        local b = updated[j]\n        local dx = b.get(\"x\", 0) - a.get(\"x\", 0)\n        local dy = b.get(\"y\", 0) - a.get(\"y\", 0)\n        local dist = sqrt(dx * dx + dy * dy)\n        local minDist = a.get(\"r\", 0) + b.get(\"r\", 0)\n        if (dist < minDist && dist > 0) {\n          local overlap = (minDist - dist) / 2\n          local nx = dx / dist\n          local ny = dy / dist\n          local a2 = copyDict(a)\n          local b2 = copyDict(b)\n          a2.set(\"x\", a.get(\"x\", 0) - nx * overlap)\n          a2.set(\"y\", a.get(\"y\", 0) - ny * overlap)\n          b2.set(\"x\", b.get(\"x\", 0) + nx * overlap)\n          b2.set(\"y\", b.get(\"y\", 0) + ny * overlap)\n          updated[i] = a2\n          updated[j] = b2\n        }\n      }\n    }\n    updated\n  }\n\nlocal ents = [{ \"id\" : 1, \"x\" : 0, \"y\" : 0, \"r\" : 5 }, { \"id\" : 2, \"x\" : 4, \"y\" : 0, \"r\" : 5 }]\nprintln(resolveCollisions(ents))\n```"}]}
