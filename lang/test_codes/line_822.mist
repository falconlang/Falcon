func printConvergenceHistory(residuals) =
  {
    local out = ""
    local maxR = residuals.max { m, n -> n > m }
    for (i: 1 .. residuals.listLen() step 1) {
      local barLen = round(residuals[i] / maxR * 40)
      local bar = ""
      for (j: 1 .. barLen step 1) {
        bar = bar _ "|"
      }
      out = out _ "Iter " _ i _ ": " _ bar _ " " _ formatDecimal(residuals[i], 4) _ "\n"
    }
    out
  }

println(printConvergenceHistory([1.0, 0.5, 0.25, 0.1, 0.02]))
