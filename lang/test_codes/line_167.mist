func nearestColor(target, palette) =
  {
      local trgb = splitColor(target)
      palette
        .min { a, b ->   local argb = splitColor(a)
        local brgb = splitColor(b)
        (argb[1] - trgb[1]) ^ 2 + (argb[2] - trgb[2]) ^ 2 + (argb[3] - trgb[3]) ^ 2 < (brgb[1] - trgb[1]) ^ 2 + (brgb[2] - trgb[2]) ^ 2 + (brgb[3] - trgb[3]) ^ 2 }
  }
