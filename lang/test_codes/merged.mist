=== line_822.mist ===
func printConvergenceHistory(residuals) =
  {
    local out = ""
    local maxR = residuals.max { m, n -> n > m }
    for (i: 1 .. residuals.listLen() step 1) {
      local barLen = round(residuals[i] / maxR * 40)
      local bar = ""
      for (j: 1 .. barLen step 1) {
        bar = bar _ "|"
      }
      out = out _ "Iter " _ i _ ": " _ bar _ " " _ formatDecimal(residuals[i], 4) _ "\n"
    }
    out
  }

println(printConvergenceHistory([1.0, 0.5, 0.25, 0.1, 0.02]))

=== line_922.mist ===
func modulo_schedule(ops, latencies, resources) =
  {
    local n = ops.listLen()
    local max_lat = latencies
      .max { m, n -> m > n }
    local ii = max_lat
    local schedule = []
    for (cycle: 0 .. ii - 1 step 1) {
      local slot = []
      for (i: 1 .. n step 1) {
        if (i - 1 % ii == cycle) {
          slot.add({ "op" : ops[i], "latency" : latencies[i], "cycle" : cycle })
        }
      }
      schedule.add(slot)
    }
    schedule
  }

println(modulo_schedule(["load", "add", "store"], [3, 1, 2], { "mem" : 1, "alu" : 1 }))

