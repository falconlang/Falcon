func longestIncreasingSubsequence(list) =
  {
    local dp = []
    for (i: 1 .. list.listLen() step 1) {
      dp.add(1)
    }
    for (i: 2 .. list.listLen() step 1) {
      for (j: 1 .. i - 1 step 1) {
        if (list[i] > list[j] && dp[i] < dp[j] + 1) {
          dp[i] = dp[j] + 1
        }
      }
    }
    dp
      .max { m, n -> m > n }
  }

