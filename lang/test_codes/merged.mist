=== line_1070.mist ===
func aggregateByGroup(records, groupField, aggField, operation) =
  {
    local grouped = {  }
    for (r in records) {
      local g = r.get(groupField, [])
      if (!grouped.containsKey(g)) {
        grouped.set(g, [])
      }
      grouped.get(g, []).add(r.get(aggField, []))
    }
    local res = {  }
    for (g, vals in grouped) {
      local v = 0
      if (operation === "sum") {
        v = vals
          .reduce(0) { a, b -> a + b }
      } else if (operation === "count") {
        v = vals.listLen()
      } else if (operation === "max") {
        v = vals
          .max { a, b -> a > b }
      } else if (operation === "min") {
        v = vals
          .min { a, b -> a < b }
      } else if (operation === "avg") {
        v = vals
          .reduce(0) { a, b -> a + b } / vals.listLen()
      }
      res.set(g, v)
    }
    res
  }

