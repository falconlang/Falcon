func softmax(scores) =
  {
      local maxS = scores
        .max { a, b -> a > b }
      local exps = scores
        .map { s -> exp(s - maxS) }
      local total = exps
        .reduce(0) { x, s -> x + s }
      exps
        .map { e -> formatDecimal(e / total, 2) }
  }

println(softmax([1.0, 2.0, 3.0]))

