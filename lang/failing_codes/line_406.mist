func gpaPoints(letterGrade) =
  { "A" : 4.0, "B" : 3.0, "C" : 2.0, "D" : 1.0, "F" : 0.0 }.get(letterGrade, 0.0)

local transcript = [["Calculus", "A", 3], ["History", "B", 3], ["Chemistry", "C", 4], ["English", "A", 3]]
local totalPoints = 0
local totalHours = 0
for (course in transcript) {
  totalPoints = totalPoints + gpaPoints(course[2]) * course[3]
  totalHours = totalHours + course[3]
}
println("GPA: " _ formatDecimal(totalPoints / totalHours, 2))

