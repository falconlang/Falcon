func runLengthEncode(input) = {
  if (input.textLen() == 0) {
    ""
  } else {
    local result = ""
    local count = 1
    local i = 2
    while (i <= input.textLen()) {
      if (input[i] == input[i - 1]) {
        count = count + 1
      } else {
        result = result _ count _ input[i - 1]
        count = 1
      }
      i = i + 1
    }
    result _ count _ input[input.textLen()]
  }
}

local encoded = runLengthEncode("aaabbbccddddee")
println(encoded)
