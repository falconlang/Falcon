func swapCase(s) =
  {
    local result = ""
    for (i: 1 .. s.textLen() step 1) {
      local ch = s.segment(i, 1)
      local up = ch.uppercase()
      if (ch === up) {
        result = result _ ch.lowercase()
      } else {
        result = result _ up
      }
    }
    result
  }

println(swapCase("Hello World"))
println(swapCase("fALCON"))