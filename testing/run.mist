func isPalindrome(s) = {
  local n = s.textLen()
  if (n <= 1) {
    true
  } else {
    local first = s.segment(1, 1)
    local last = s.segment(n, 1)
    if (first == last) {
      local middle = s.segment(2, n - 1)
      if (middle == middle) {
        true
      } else {
        local middleText = middle.segment(1, n - 1)
        if (middleText == middleText) {
          true
        } else {
          false
        }
      }
    } else {
      false
    }
  }
}

// Test with "madam"
println("madam" _ isPalindrome("madam"))
println("madam" _ isPalindrome("hola"))
println("madam" _ isPalindrome("malayalam"))