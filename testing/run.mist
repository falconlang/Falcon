func stripPunctuation(s) = {
    local punct = [".", ",", "!", "?", ";", ":", "'", "\"", "(", ")", "[", "]", "{", "}", "-", "_", "/", "@", "#", "$", "%", "&", "*", "+", "=", "<", ">", "~", "`", "^", "|", "\\"]
    local result = ""
    for (i: 1 .. s.textLen()) {
        local ch = s.segment(i, 1)
        if (!punct.containsItem(ch)) {
            result = result _ ch
        }
    }
    result
}
println(stripPunctuation("Hello, World! How's it going?"))
println(stripPunctuation("Price: $9.99 (sale!)"))