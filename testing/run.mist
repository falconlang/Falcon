func composeTextOps(ops, s) = {
  local result = s
  for (op in ops) {
    if (op === "trim") {
      result = result.trim()
    } else if (op === "uppercase") {
      result = result.uppercase()
    } else if (op === "lowercase") {
      result = result.lowercase()
    } else if (op === "reverse") {
      result = result.reverse()
    }
  }
  result
}

// Test cases
println(composeTextOps(["trim", "uppercase"], "  hello world  "))
// Expected: "HELLO WORLD"

println(composeTextOps(["reverse", "lowercase"], "ABC"))
// Expected: "cba"

println(composeTextOps(["uppercase", "reverse", "trim"], "  Falcon  "))
// Expected: "NOCALF"