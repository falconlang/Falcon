func fooBar() = {
  if (true) {
    println("kat")
  } else if (false) {
    println("duhh")
  } else {
    yield 1
  }
  if (true) {
    println("a")
  } else if (false) {
    println("bugg")
  } else {
    yield 100000
  }
  local a = 1
  println(a)
  if (false) {
    println("katze")
    yield "hola"
  }
  if (true) {
    yield "boww"
  }
  "meow"
}

println(fooBar())