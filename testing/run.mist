  func analyzeFunnel(rates) = {
    local overall = rates.reduce(1) { rate, acc -> rate * acc }
    local minRate = rates.min { a, b -> a < b }
    local stepIndex = rates.indexOf(minRate)
    {
      "overall": overall,
      "minRate": minRate,
      "dropOffStep": stepIndex
    }
  }

  local conversionRates = [0.5, 0.3, 0.8, 0.9]
  local result = analyzeFunnel(conversionRates)
  println("Funnel conversion rates: " _ conversionRates.join(" -> "))
  println("Overall conversion: " _ result.get("overall", 0))
  println("Greatest drop-off rate: " _ result.get("minRate", 0))
  println("Drop-off occurs at step: " _ result.get("dropOffStep", 0))