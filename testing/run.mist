func encodeRLE(s) =
  {
    if (s.textLen() == 0) {
      ""
    } else {
      local result = ""
      local curr = s.segment(1, 1)
      local count = 1

      for (i: 2 .. s.textLen() step 1) {
        local ch = s.segment(i, 1)
        if (ch === curr) {
          count = count + 1
        } else {
          result = result _ count _ curr
          curr = ch
          count = 1
        }
      }

      result _ count _ curr
    }
  }

println(encodeRLE("aaabbc"))   // 3a2b1c
println(encodeRLE("aabbcc"))   // 2a2b2c
println(encodeRLE("abcdef"))   // 1a1b1c1d1e1f
println(encodeRLE(""))         // ""