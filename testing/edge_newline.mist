func test1() = {
  println("same-line subtraction:")
  local x = 10 - 3
  x
}

func test2() = {
  println("negative literal return after statement:")
  println("before")
  -5
}

func test3() = {
  println("operator continues on next line (multi-line expr):")
  local a = 4
  local b = 3
  local result = a +
    b
  result
}

func test4() = {
  println("unary minus in assignment:")
  local x = -7
  x
}

func test5() = {
  println("multi-statement, last is negative:")
  println("a")
  println("b")
  -99
}

println(test1())
println(test2())
println(test3())
println(test4())
println(test5())
