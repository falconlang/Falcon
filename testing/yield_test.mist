println("=== 1. basic yield with fallback ===")
func find_index(target, list) {
  for (i: 1..list.listLen()) {
    if (list[i] == target) {
      yield i
    }
  }
  -1
}
local myList = ["cat", "dog", "cheetha"]
println(find_index("cat", myList))
println(find_index("dog", myList))
println(find_index("cheetha", myList))
println(find_index("fish", myList))

println("=== 2. yield from nested if (no match path) ===")
func classify(n) {
  if (n < 0) {
    yield "negative"
  }
  if (n == 0) {
    yield "zero"
  }
  "positive"
}
println(classify(-5))
println(classify(0))
println(classify(42))

println("=== 3. yield inside while loop ===")
func first_even(list) {
  local i = 1
  while (i <= list.listLen()) {
    if (list[i] % 2 == 0) {
      yield list[i]
    }
    i = i + 1
  }
  -1
}
println(first_even([1, 3, 5, 4, 7]))
println(first_even([1, 3, 5]))

println("=== 4. yield returns correct expression type ===")
func double_if_positive(n) {
  if (n > 0) {
    yield n * 2
  }
  0
}
println(double_if_positive(5))
println(double_if_positive(-3))
println(double_if_positive(0))

println("=== 5. yield value used in expression ===")
func safe_div(a, b) {
  if (b == 0) {
    yield 0
  }
  a / b
}
println(safe_div(10, 2))
println(safe_div(9, 3))
println(safe_div(5, 0))

println("=== 6. fallback is last expression (no yield hit) ===")
func identity(x) {
  x
}
println(identity(99))
println(identity("hello"))