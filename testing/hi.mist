func aimAngle(px, py, tx, ty) = {
      local dx = tx - px
      local dy = ty - py
      local angle = if (dx > 0) {
        atan(dy / dx)
      } else if (dx < 0 && dy >= 0) {
        atan(dy / dx) + 3.14159265358979
      } else if (dx < 0 && dy < 0) {
        atan(dy / dx) - 3.14159265358979
      } else if (dx == 0 && dy > 0) {
        1.5707963267949
      } else if (dx == 0 && dy < 0) {
        -1.5707963267949
      } else {
        0
      }
      degrees(angle)
}