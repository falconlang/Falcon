func fooBar() = {
  if (false) {
    for (a in []) {
        for (b in []) {
          if (true) {
            yield 10
          }
        }
      }
  }
  println("katze")
  if (true) {
    yield -7
  } else if (false) {
    println("bruh")
  } else if (false) {
    yield 8
  } else if (true) {
    println("meow")
  }
  -1
}

println(fooBar())