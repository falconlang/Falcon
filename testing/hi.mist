func rleEncode(s) = {

local res = []

local i = 1

local len = s.textLen()
  while (i <= len) {

local ch = s.segment(i,1)
    if (i == len) { res.add([ch, i]) }
    else {

local count = 1
      while (i+1 <= len && s.segment(i+1,1) === ch) { count = count+1 i = i+1 }
      res.add([ch, count])
    i = i+count
      
    }
  }
  res
}
println(rleEncode("aabcccdd"))
