func rleEncode(s) =
  {
    local chars = {  }
    for (i: 1 .. s.textLen() step 1) {
      local ch = s.segment(i, i)
      if (chars.containsKey(ch)) {
        chars[ch] = chars[ch] + 1
      } else {
        chars.set(ch, 1)
      }
    }
    local runs = []
    for (k: 1 .. chars.keys() step 1) {
      local count = chars[k]
      if (count > 1) {
        runs.add(k _ "x" _ count)
      }
    }
    local encoded = ""
    for (r in runs) {
      encoded = encoded _ r
    }
    encoded
  }

println(rleEncode("AAAAABBBCC"))
println(rleEncode("abcdef"))