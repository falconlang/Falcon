func rle(s) =
  {
    local result = []
    local current = s.segment(1, 1)
    local count = 1
    for (i: 2.. s.textLen() step 1) {
      local ch = s.segment(i, 1)
      if (ch === current) {
        count = count + 1
      } else {
        result.add([current, count])
        current = ch
        count = 1
      }
    }
    result.add([current, count])
    result
  }
