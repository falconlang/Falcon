func runLengthEncode(text) = {
  if (text.textLen() == 0) {
    yield ""
  }

  local result = ""
  local currentChar = text.segment(1, 1)
  local count = 1

  for (i: 2 .. text.textLen()) {
    if (text.segment(i, 1) === currentChar) {
      count = count + 1
    } else {
      result = result _ currentChar _ count
      currentChar = text.segment(i, 1)
      count = 1
    }
  }

  // Append the last group
  result = result _ currentChar _ count
  result
}

// Test case
println(runLengthEncode("aaaabbbcc"))